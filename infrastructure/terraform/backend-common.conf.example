## Common S3-compatible backend settings for DigitalOcean Spaces
## Copy this file to 'backend-common.conf' at the same path and DO NOT commit your keys.
## Keep only non-sensitive settings here (bucket/region/endpoint). Supply credentials
## via environment variables (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY) or CI secrets.

bucket = "tup-firemonitoring-state"
region = "us-east-1"

endpoints = {
  s3 = "https://sgp1.digitaloceanspaces.com"
}

# For safety, do not include access_key/secret_key in this file. Provide them via env.
# The following flags are generally not recommended unless your environment requires them.
# skip_credentials_validation = true
# skip_metadata_api_check     = true
# skip_region_validation      = true
# skip_requesting_account_id  = true
use_path_style = true
