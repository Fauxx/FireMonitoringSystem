    {
      "id": 21,
      "title": "Pod CPU Engine",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-fire"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 8,
        "h": 8
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fire"
          },
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"fire-monitoring-dev\"}[5m])) by (pod)",
          "range": true,
          "instant": false
        }
      ]
    },
