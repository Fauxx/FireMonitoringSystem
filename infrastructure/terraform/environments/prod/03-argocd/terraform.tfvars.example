# Remote state configuration
remote_state_bucket   = "tup-firemonitoring-state"
infra_state_key       = "prod/01-infra/terraform.tfstate"
remote_state_region   = "us-east-1"
remote_state_endpoint = "sgp1.digitaloceanspaces.com"

# GitOps repository settings
gitops_repo_url          = "https://github.com/Fauxx/FireMonitoringSystem"
gitops_repo_branch       = "main"
gitops_repo_apps_path    = "infrastructure/k8s/overlays/prod"
# Base64-encoded SSH private key for ArgoCD (optional if using HTTPS access)
# gitops_repo_ssh_private_key = ""
