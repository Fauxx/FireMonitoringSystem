# =================================================================
# 1. SYSTEM & IDE (The "Personal" stuff)
# =================================================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.bak

# =================================================================
# 2. ENVIRONMENT & SECRETS (CRITICAL: Do not push these!)
# =================================================================
.env
.env.*
!.env.example
secrets.txt
*.tfvars
infrastructure/k8s/overlays/dev/secrets.yaml
# =================================================================
# 3. NODE.JS / DASHBOARD (The "Web" layer)
# =================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
.npm
dist/
build/*
!build/compose/
!build/compose/**
.cache/

# =================================================================
# 4. PYTHON / ETL (The "Data" layer)
# =================================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
.pytest_cache/
.mypy_cache/

# =================================================================
# 5. INFRASTRUCTURE & PERSISTENT DATA
# =================================================================
# Ignore runtime/persistent data but keep the directory structure.
# Note: declarative MQTT/K8s config now lives under infrastructure/k8s/base/mqtt.
infrastructure/mqtt/data/*
infrastructure/mqtt/log/*
infrastructure/influxdb/data/*
infrastructure/influxdb/config/*
postgres_data/

# Allow git to keep the directories but ignore the content
!infrastructure/mqtt/data/.gitkeep
!infrastructure/mqtt/log/.gitkeep


# =================================================================
# 6. DOCKER & LOGS
# =================================================================
api/logs/
*.log
.docker/
# Terraform local artifacts (do not commit)
infrastructure/terraform/.terraform/
infrastructure/terraform/*.tfstate
infrastructure/terraform/*.tfstate.*
infrastructure/terraform/crash.log
infrastructure/terraform/backend.local.env
infrastructure/terraform/override.tf
infrastructure/terraform/override.tf.json
infrastructure/terraform/*_override.tf
infrastructure/terraform/*_override.tf.json


# =================================================================
# 6. TERRAFORM (Monorepo optimized)
# =================================================================
# Ignore all hidden terraform directories in any subdirectory
**/.terraform/

# Ignore all state files (sensitive and environment-specific)
**/*.tfstate
**/*.tfstate.*

# Ignore all variable files except examples
**/*.tfvars
!**/*.tfvars.example

# Infrastructure logs and local overrides
**/crash.log
**/*_override.tf
**/*_override.tf.json
.terraform.rc
terraform.rc