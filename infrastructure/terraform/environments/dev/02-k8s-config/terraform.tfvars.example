remote_state_bucket = "tup-firemonitoring-state"
remote_state_key    = "dev/01-infra/terraform.tfstate"
remote_state_region = "us-east-1"
remote_state_endpoint = "https://sgp1.digitaloceanspaces.com"

github_token            = "PASTE_GITHUB_TOKEN"
github_owner            = "PASTE_GITHUB_OWNER"
github_repo             = "FireMonitoringSystem"

ghcr_deploy_username = "PASTE_GHCR_USERNAME"
ghcr_deploy_token    = "PASTE_GHCR_TOKEN"

argocd_server     = "https://argocd.example.com"
argocd_auth_token = "PASTE_ARGOCD_AUTH_TOKEN"

postgres_user     = "fireuser"
postgres_password = "local-password"
postgres_db       = "fire_monitoring"
postgres_host     = "db"
postgres_port     = 5432
pgsslmode         = "disable"
database_url      = "postgresql://fireuser:local-password@db:5432/fire_monitoring"

influxdb_init_mode       = "setup"
influxdb_username        = "admin"
influxdb_password        = "adminpassword123"
influxdb_url             = "http://influx:8086"
influxdb_token           = "local-influx-token"
influxdb_org             = "fire-monitoring"
influxdb_bucket          = "sensor-data"
influxdb_cli_config_name = "firedev"
influx_measurement     = "fire_data"

mqtt_broker_host = "mqtt"
mqtt_broker_port = 1883

etl_sync_interval  = 30
agg_window_minutes = 5

threshold_smoke_orange = 100
threshold_smoke_red    = 250
threshold_temp_orange  = 38.0
threshold_temp_red     = 45.0

github_app_id = "PASTE_GITHUB_APP_ID"
github_app_installation_id = "PASTE_GITHUB_APP_INSTALLATION_ID"
# Base64-encode the PEM contents before pasting here.
github_app_private_key = "PASTE_BASE64_ENCODED_GITHUB_APP_PRIVATE_KEY"
