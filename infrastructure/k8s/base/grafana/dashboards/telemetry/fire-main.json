          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-fire"
          },
          "query": "from(bucket: \"sensor-data\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"node_telemetry\")\n  |> last()\n  |> pivot(rowKey:[\"_time\", \"h_id\"], columnKey: [\"_field\"], valueColumn: \"_value\")"
        }
