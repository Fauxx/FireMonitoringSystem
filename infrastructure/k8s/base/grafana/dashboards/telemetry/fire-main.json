        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-fire"
          },
          "query": "import \"experimental\"\n\nfrom(bucket: \"sensor-data\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"node_telemetry\")\n  |> filter(fn: (r) => r[\"_field\"] == \"lat\" or r[\"_field\"] == \"lon\" or r[\"_field\"] == \"status\" or r[\"_field\"] == \"flame\")\n  |> last()\n  |> pivot(rowKey: [\"h_id\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  // Safe mapping configuration to handle missing fields cleanly\n  |> map(fn: (r) => {\n      keys = experimental.objectKeys(o: r)\n      hasFlame = contains(value: \"flame\", set: keys)\n      hasStatus = contains(value: \"status\", set: keys)\n      hasLat = contains(value: \"lat\", set: keys)\n      hasLon = contains(value: \"lon\", set: keys)\n      hasTime = contains(value: \"_time\", set: keys)\n      \n      return {\n          id: r.h_id,\n          reading: if hasFlame then r[\"flame\"] else 0.0,\n          status: if hasStatus then r[\"status\"] else 0,\n          time: if hasTime then r[\"_time\"] else time(v: \"2026-06-17T00:00:00Z\"),\n          lat: if hasLat then r[\"lat\"] else 0.0,\n          lon: if hasLon then r[\"lon\"] else 0.0\n      }\n  })\n  |> keep(columns: [\"id\", \"reading\", \"status\", \"time\", \"lat\", \"lon\"])",
          "refId": "A"
        }
      ],
      "type": "geomap"
    },
