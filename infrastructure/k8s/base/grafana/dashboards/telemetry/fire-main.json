    },
    {
      "id": 11,
      "title": "Barangay Map",
      "type": "geomap",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-fire"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 16,
        "h": 12
      },
      "options": {
        "view": {
          "id": "coords",
          "lat": 14.5995,
          "lon": 121.0365,
          "zoom": 11
        },
        "basemap": {
          "type": "default",
          "name": "OpenStreetMap",
          "config": {}
        },
        "layers": [
          {
            "type": "markers",
            "name": "Active Sensors",
            "config": {
              "style": {
                "size": {
                  "fixed": 15
                },
                "color": {
                  "field": "status",
                  "fixed": "green"
                },
                "symbol": {
                  "fixed": "circle"
                }
              },
              "location": {
                "mode": "auto"
              },
              "tooltip": true
            }
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "orange"
              },
              {
                "value": 2,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-fire"
          },
          "query": "from(bucket: \"sensor-data\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"node_telemetry\")\n  |> filter(fn: (r) => r[\"_field\"] == \"lat\" or r[\"_field\"] == \"lon\" or r[\"_field\"] == \"status\")\n  |> last()\n  |> pivot(rowKey:[\"_time\", \"h_id\"], columnKey: [\"_field\"], valueColumn: \"_value\")"
        }
      ]
    },
    {
      "id": 12,
      "title": "Fleet Alert Status Counters",
      "type": "stat",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-fire"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 12
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "valueAndName"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Total Fleet"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-grey"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Normal Status"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Warning Status"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "D"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Critical Status"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-fire"
          },
          "query": "from(bucket: \"sensor-data\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"node_telemetry\")\n  |> filter(fn: (r) => r[\"_field\"] == \"status\")\n  |> group(columns: [\"h_id\"])\n  |> last()\n  |> group()\n  |> count()"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-fire"
          },
          "query": "from(bucket: \"sensor-data\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"node_telemetry\")\n  |> filter(fn: (r) => r[\"_field\"] == \"status\")\n  |> filter(fn: (r) => r._value == 0)\n  |> group(columns: [\"h_id\"])\n  |> last()\n  |> group()\n  |> count()"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-fire"
          },
          "query": "from(bucket: \"sensor-data\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"node_telemetry\")\n  |> filter(fn: (r) => r[\"_field\"] == \"status\")\n  |> filter(fn: (r) => r._value == 1)\n  |> group(columns: [\"h_id\"])\n  |> last()\n  |> group()\n  |> count()"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-fire"
          },
          "query": "from(bucket: \"sensor-data\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"node_telemetry\")\n  |> filter(fn: (r) => r[\"_field\"] == \"status\")\n  |> filter(fn: (r) => r._value == 2)\n  |> group(columns: [\"h_id\"])\n  |> last()\n  |> group()\n  |> count()"
        }
      ]
    },
    {
      "id": 13,
      "title": "Active Device List Overview",
